{
  "name": "mdsyncview",
  "version": "0.1.0",
  "private": true,
  "description": "MDSyncView — discover, watch and beautifully render every Markdown file on this machine, in real time.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch --no-warnings=ExperimentalWarning server/src/index.ts --dev --no-open",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "node --no-warnings=ExperimentalWarning server/src/index.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "node --no-warnings=ExperimentalWarning --test server/test/*.test.ts",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.4",
    "gray-matter": "^4.0.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@mdit/plugin-alert": "^2.0.1",
    "@mdit/plugin-katex": "^1.1.1",
    "@tanstack/react-virtual": "^3.14.12",
    "@types/js-yaml": "^4.0.9",
    "@types/morphdom": "^2.3.0",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9",
    "dompurify": "^3.4.15",
    "esbuild": "^0.28.2",
    "fuzzysort": "^4.0.2",
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.4.1",
    "katex": "^0.18.7",
    "lucide-react": "^1.45.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.0.0",
    "morphdom": "^2.7.8",
    "postject": "^1.0.0-alpha.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9",
    "vite": "^8.3.0",
    "zustand": "^5.0.15"
  }
}
